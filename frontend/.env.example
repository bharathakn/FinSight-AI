# URL of the FinSight API gateway (no trailing slash).
# Local:  make serve  (inprocess)  or  make up  (Docker microservices)  → http://localhost:8000
# Vercel: Project → Settings → Environment Variables → VITE_API_BASE_URL = https://<your-render-service>.onrender.com
VITE_API_BASE_URL=http://localhost:8000
